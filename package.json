{
  "name": "doguxclaude",
  "version": "0.1.0",
  "description": "Claude Code'u makinendeki depoların haritasıyla başlatır. Harita kodla çıkarılır, tek satırlık açıklamaları model yazar.",
  "type": "module",
  "bin": {
    "dxc": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Doğukan Şahin",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "claude-cli",
    "context",
    "repo-map",
    "codebase-map",
    "project-context",
    "system-prompt",
    "ai-context",
    "agent-memory",
    "cli",
    "developer-tools",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdogukan/doguxclaude.git"
  },
  "homepage": "https://github.com/sdogukan/doguxclaude#readme",
  "bugs": {
    "url": "https://github.com/sdogukan/doguxclaude/issues"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "cfonts": "^3.3.1",
    "cli-progress": "^3.12.0",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1"
  }
}
